# /etc/aquilo-state-local.env  (chmod 600)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=svc_aquilo
MQTT_PASS=change-me
# The gateway's id: the account name it logs in to the broker with.
AQUILO_GATEWAY_ID=abc123
AQUILO_CONFIG=/etc/aquilo-sensors.json
AQUILO_STORE=/var/lib/aquilo-state-local/store.json
